APP_ENV=development
ENVIRONMENT=development
APP_DEBUG=false
APP_VERSION=0.3.0
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
JWT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
SECRET_KEY=replace-with-another-independent-random-secret
FIELD_ENCRYPTION_KEY=GENERATE_WITH_deploy_generate_secrets_sh
ENCRYPTION_KEY_VERSION=v1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_MFA=false
SECURE_COOKIES=false
HTTPS_ONLY=false
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgresql+psycopg://gnk@postgres:5432/gnk
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@gnkalgo.local
SMTP_USE_TLS=false
TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
STARTUP_CONNECTIVITY_CHECK=true
BROKER_CALLBACK_STATE_TTL_SECONDS=600

# Individual broker account inspection; does not authorize live execution.
INDIVIDUAL_BROKER_SETUP_ENABLED=true
# Required for Angel One: operator's real public API egress IP, not a sample IP.
BROKER_EGRESS_IP=

# Risk acknowledgment: each login, plus a fresh UTC interval (24 hours by default).
DISCLOSURE_VERSION=2026-11-02.1
DISCLOSURE_MAX_AGE_HOURS=24
# Enable publication only after independent verification/authorization.
CONTACT_CHANNELS_VERIFIED=false
COMPANY_REGISTRATION_VERIFIED=false
COMPANY_LEGAL_NAME=
COMPANY_SEBI_REGISTRATION=
COMPANY_BASL_APPLICABLE=false
COMPANY_BASL_MEMBERSHIP=
COMPANY_OFFICE_ADDRESS_VERIFIED=false
COMPANY_OFFICE_ADDRESS=

# Phase 05: market data is independent of order execution and individual broker tokens.
UPSTOX_ENABLED=false
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ANALYTICS_TOKEN_FILE=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_MARKET_DATA_MODE=ltpc
UPSTOX_WEBSOCKET_ENABLED=false
UPSTOX_INSTRUMENT_SYNC_ENABLED=true
UPSTOX_HISTORICAL_SYNC_ENABLED=false
MARKETDATA_DISTRIBUTION_APPROVED=false
MARKETDATA_APPROVAL_REFERENCE=
MARKETDATA_ALLOWED_SEGMENTS=NSE_EQ,BSE_EQ,NSE_FO,BSE_FO,NSE_INDEX,BSE_INDEX
MARKETDATA_ALLOWED_MODES=ltpc
MARKETDATA_MAX_USERS=1
MARKETDATA_MAX_INSTRUMENTS=1000
MARKETDATA_PER_USER_LIMIT=50
MARKETDATA_STALE_SECONDS=15
MARKETDATA_CACHE_SECONDS=300
MARKETDATA_STREAM_MAXLEN=10000
MARKETDATA_TICK_PERSIST_SECONDS=0
MARKETDATA_TICK_RETENTION_HOURS=24
MARKETDATA_WORKER_LEASE_SECONDS=30
MARKETDATA_QUEUE_SIZE=512
MARKETDATA_HOLIDAYS=
MARKETDATA_SPECIAL_SESSIONS={}
