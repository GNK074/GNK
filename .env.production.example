APP_ENV=production
ENVIRONMENT=production
APP_DEBUG=false
APP_VERSION=0.3.0
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://gnkalgo.com
BACKEND_URL=https://api.gnkalgo.com
CORS_ALLOWED_ORIGINS=https://gnkalgo.com
JWT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
SECRET_KEY=replace-with-another-independent-random-secret
FIELD_ENCRYPTION_KEY=GENERATE_WITH_deploy_generate_secrets_sh
ENCRYPTION_KEY_VERSION=v1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_MFA=true
SECURE_COOKIES=true
HTTPS_ONLY=true
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
APP_DB_PASSWORD_FILE=./secrets/app_db_password
DATABASE_URL=postgresql+psycopg://gnk_app@postgres:5432/gnk
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@gnkalgo.com
SMTP_USE_TLS=true
TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
STARTUP_CONNECTIVITY_CHECK=true
BROKER_CALLBACK_STATE_TTL_SECONDS=600
SMTP_USERNAME=CONFIGURE_REAL_SMTP_USER
SMTP_PASSWORD=CONFIGURE_REAL_SMTP_PASSWORD
# Proposed callbacks; register exact addresses with each broker before enabling.
BROKER_CALLBACK_BASE_URL=https://api.gnkalgo.com
DHAN_CLIENT_ID=
DHAN_CLIENT_SECRET=
DHAN_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/dhan/callback
ZERODHA_CLIENT_ID=
ZERODHA_CLIENT_SECRET=
ZERODHA_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/zerodha/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/upstox/callback
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_SECRET=
ANGELONE_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/angelone/callback
FYERS_CLIENT_ID=
FYERS_CLIENT_SECRET=
FYERS_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/fyers/callback
P5PAISA_CLIENT_ID=
P5PAISA_CLIENT_SECRET=
P5PAISA_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/5paisa/callback
ICICI_CLIENT_ID=
ICICI_CLIENT_SECRET=
ICICI_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/icici/callback

# Individual broker account inspection; does not authorize live execution.
INDIVIDUAL_BROKER_SETUP_ENABLED=true
# Required for Angel One: operator's real public API egress IP, not a sample IP.
BROKER_EGRESS_IP=

# Risk acknowledgment: each login, plus a fresh UTC interval (24 hours by default).
DISCLOSURE_VERSION=2026-11-02.1
DISCLOSURE_MAX_AGE_HOURS=24
# Enable publication only after independent verification/authorization.
CONTACT_CHANNELS_VERIFIED=false
COMPANY_REGISTRATION_VERIFIED=false
COMPANY_LEGAL_NAME=
COMPANY_SEBI_REGISTRATION=
COMPANY_BASL_APPLICABLE=false
COMPANY_BASL_MEMBERSHIP=
COMPANY_OFFICE_ADDRESS_VERIFIED=false
COMPANY_OFFICE_ADDRESS=

# Phase 05: market data is independent of order execution and individual broker tokens.
UPSTOX_ENABLED=false
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ANALYTICS_TOKEN_FILE=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_MARKET_DATA_MODE=ltpc
UPSTOX_WEBSOCKET_ENABLED=false
UPSTOX_INSTRUMENT_SYNC_ENABLED=true
UPSTOX_HISTORICAL_SYNC_ENABLED=false
MARKETDATA_DISTRIBUTION_APPROVED=false
MARKETDATA_APPROVAL_REFERENCE=
MARKETDATA_ALLOWED_SEGMENTS=NSE_EQ,BSE_EQ,NSE_FO,BSE_FO,NSE_INDEX,BSE_INDEX
MARKETDATA_ALLOWED_MODES=ltpc
MARKETDATA_MAX_USERS=1
MARKETDATA_MAX_INSTRUMENTS=1000
MARKETDATA_PER_USER_LIMIT=50
MARKETDATA_STALE_SECONDS=15
MARKETDATA_CACHE_SECONDS=300
MARKETDATA_STREAM_MAXLEN=10000
MARKETDATA_TICK_PERSIST_SECONDS=0
MARKETDATA_TICK_RETENTION_HOURS=24
MARKETDATA_WORKER_LEASE_SECONDS=30
MARKETDATA_QUEUE_SIZE=512
MARKETDATA_HOLIDAYS=
MARKETDATA_SPECIAL_SESSIONS={}

# Upstox live execution: disabled until implementation/operational acceptance.
UPSTOX_EXECUTION_ENABLED=false
LIVE_EXECUTION_REFERENCE=
UPSTOX_ALGO_NAME=
LIVE_PRICE_DEVIATION_PERCENT=2
# Set only after verifying provider tick-size units for the permitted NSE EQ scope.
LIVE_TICK_SIZE_MULTIPLIER=0

# Dhan: independent switches; preserve existing global and Upstox settings.
DHAN_STREAM_ENABLED=true
# Requires registered personal application and exact HTTPS callback registration.
DHAN_OAUTH_ENABLED=false
# Activate only after broker acceptance, verified instrument units and GNK approval.
DHAN_EXECUTION_ENABLED=false
DHAN_EXECUTION_REFERENCE=
DHAN_TICK_SIZE_MULTIPLIER=0
DHAN_STREAM_WORKER_MEMORY_LIMIT=1g
