APP_ENV=production
ENVIRONMENT=production
APP_DEBUG=false
APP_VERSION=0.3.0
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://gnkalgo.com
BACKEND_URL=https://api.gnkalgo.com
CORS_ALLOWED_ORIGINS=https://gnkalgo.com
JWT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
SECRET_KEY=replace-with-another-independent-random-secret
FIELD_ENCRYPTION_KEY=GENERATE_WITH_deploy_generate_secrets_sh
ENCRYPTION_KEY_VERSION=v1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_MFA=true
SECURE_COOKIES=true
HTTPS_ONLY=true
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
APP_DB_PASSWORD_FILE=./secrets/app_db_password
DATABASE_URL=postgresql+psycopg://gnk_app@postgres:5432/gnk
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@gnkalgo.com
SMTP_USE_TLS=true
TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
STARTUP_CONNECTIVITY_CHECK=true
BROKER_CALLBACK_STATE_TTL_SECONDS=600
SMTP_USERNAME=CONFIGURE_REAL_SMTP_USER
SMTP_PASSWORD=CONFIGURE_REAL_SMTP_PASSWORD
# Proposed callbacks; register exact addresses with each broker before enabling.
BROKER_CALLBACK_BASE_URL=https://api.gnkalgo.com
DHAN_CLIENT_ID=
DHAN_CLIENT_SECRET=
DHAN_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/dhan/callback
ZERODHA_CLIENT_ID=
ZERODHA_CLIENT_SECRET=
ZERODHA_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/zerodha/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/upstox/callback
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_SECRET=
ANGELONE_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/angelone/callback
FYERS_CLIENT_ID=
FYERS_CLIENT_SECRET=
FYERS_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/fyers/callback
P5PAISA_CLIENT_ID=
P5PAISA_CLIENT_SECRET=
P5PAISA_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/5paisa/callback
ICICI_CLIENT_ID=
ICICI_CLIENT_SECRET=
ICICI_REDIRECT_URI=https://api.gnkalgo.com/api/v1/brokers/icici/callback
